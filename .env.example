# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (Gemini) — vision + reasoning
# Get from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Default model: gemini-flash-latest is an alias that Google keeps
# pointing at the most recent stable Flash model. It auto-tracks deprecations
# (gemini-2.0-flash was retired, gemini-2.5-flash is now restricted for new
# users). The fallback chain in lib/ai/google-ai.ts tries gemini-flash-lite-latest,
# gemini-pro-latest, gemini-2.5-flash-lite, gemini-3-flash-preview before failing.
GOOGLE_AI_VISION_MODEL=gemini-flash-latest
GOOGLE_AI_TEXT_MODEL=gemini-flash-latest

# Sentry (optional — leave blank to disable)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

NEXT_PUBLIC_APP_URL=http://localhost:3000
