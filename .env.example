# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (Gemini) — vision + reasoning
# Get from https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Default models. gemini-2.5-flash is stable, supports vision, free tier.
# gemini-2.0-flash was deprecated by Google in late 2025 — if Google
# deprecates another model in the future, lib/ai/google-ai.ts has a
# fallback chain that automatically tries gemini-flash-latest and
# gemini-2.5-flash-lite before failing.
GOOGLE_AI_VISION_MODEL=gemini-2.5-flash
GOOGLE_AI_TEXT_MODEL=gemini-2.5-flash

# Sentry (optional — leave blank to disable)
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

NEXT_PUBLIC_APP_URL=http://localhost:3000
